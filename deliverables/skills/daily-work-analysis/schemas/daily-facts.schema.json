{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daily-work-analysis.local/schemas/daily-facts.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["data_contract_version", "period", "metrics", "missing_people", "full_day_leave_people", "half_day_leave_people", "review_required_people", "work_composition", "status_distribution", "project_candidates", "collaborations", "risk_candidates", "evidence"],
  "properties": {
    "data_contract_version": {"type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$"},
    "period": {"type": "object", "additionalProperties": false, "required": ["start_date", "end_date", "timezone"], "properties": {"report_date": {"type": "string", "format": "date"}, "start_date": {"type": "string", "format": "date"}, "end_date": {"type": "string", "format": "date"}, "timezone": {"const": "Asia/Shanghai"}}},
    "metrics": {"$ref": "#/$defs/metrics"},
    "missing_people": {"$ref": "#/$defs/people"},
    "full_day_leave_people": {"$ref": "#/$defs/people"},
    "half_day_leave_people": {"$ref": "#/$defs/people"},
    "review_required_people": {"$ref": "#/$defs/people"},
    "work_composition": {"type": "array", "items": {"$ref": "#/$defs/work_item"}},
    "status_distribution": {"$ref": "#/$defs/status_distribution"},
    "project_candidates": {"type": "array", "items": {"$ref": "#/$defs/project_candidate"}},
    "collaborations": {"type": "array", "items": {"$ref": "#/$defs/collaboration"}},
    "risk_candidates": {"type": "array", "items": {"$ref": "#/$defs/risk_candidate"}},
    "attendance_summary": {"$ref": "#/$defs/attendance_summary"},
    "efficiency_summary": {"type": "array", "items": {"$ref": "#/$defs/efficiency_item"}},
    "formal_project_dynamics": {"type": "array", "items": {"$ref": "#/$defs/project_dynamic"}},
    "unlinked_project_dynamics": {"type": "array", "items": {"$ref": "#/$defs/project_dynamic"}},
    "stale_project_alerts": {"type": "array", "items": {"$ref": "#/$defs/stale_project_alert"}},
    "project_continuity": {"type": "array", "items": {"$ref": "#/$defs/project_continuity"}},
    "project_associations": {"type": "array", "items": {"$ref": "#/$defs/project_association"}},
    "risk_assessment": {"type": "array", "items": {"$ref": "#/$defs/risk_assessment"}},
    "data_quality": {"$ref": "#/$defs/data_quality"},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
  },
  "allOf": [{
    "if": {"properties": {"data_contract_version": {"pattern": "^1\\.2\\."}}},
    "then": {
      "required": ["project_continuity", "project_associations", "risk_assessment"],
      "properties": {"period": {"required": ["report_date"]}}
    }
  }],
  "$defs": {
    "metrics": {"type": "object", "additionalProperties": false, "required": ["roster_people", "expected_people", "submitted_people", "submission_rate", "missing_people", "full_day_leave_people", "half_day_leave_people", "review_required_people", "effective_task_count", "risk_or_blocked_count"], "properties": {"roster_people": {"type": "integer", "minimum": 0}, "expected_people": {"type": ["integer", "null"], "minimum": 0}, "submitted_people": {"type": "integer", "minimum": 0}, "submission_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1}, "missing_people": {"type": "integer", "minimum": 0}, "full_day_leave_people": {"type": "integer", "minimum": 0}, "half_day_leave_people": {"type": "integer", "minimum": 0}, "review_required_people": {"type": "integer", "minimum": 0}, "effective_task_count": {"type": "integer", "minimum": 0}, "risk_or_blocked_count": {"type": "integer", "minimum": 0}}},
    "person": {"type": "object", "additionalProperties": false, "required": ["person_id", "name", "work_period_status", "review_reason", "source_record_id"], "properties": {"person_id": {"type": "string", "minLength": 1}, "name": {"type": "string", "minLength": 1}, "work_period_status": {"type": ["string", "null"]}, "review_reason": {"type": ["string", "null"]}, "source_record_id": {"type": ["string", "null"]}}},
    "people": {"type": "array", "items": {"$ref": "#/$defs/person"}},
    "work_item": {"type": "object", "additionalProperties": false, "required": ["task_id", "report_id", "person_id", "time_period", "task_type", "project_candidate_id", "status", "output", "next_step"], "properties": {"task_id": {"type": "string"}, "report_id": {"type": "string"}, "person_id": {"type": "string"}, "time_period": {"enum": ["morning", "afternoon"]}, "task_type": {"enum": ["project", "internal", "meeting", "training", "administrative", "other"]}, "project_candidate_id": {"type": ["string", "null"]}, "status": {"enum": ["planned", "in_progress", "blocked", "completed"]}, "output": {"type": ["string", "null"]}, "next_step": {"type": ["string", "null"]}}},
    "status_distribution": {"type": "object", "additionalProperties": false, "required": ["blocked", "completed", "in_progress", "planned"], "properties": {"blocked": {"type": "integer"}, "completed": {"type": "integer"}, "in_progress": {"type": "integer"}, "planned": {"type": "integer"}}},
    "project_candidate": {"type": "object", "additionalProperties": false, "required": ["project_id", "standard_name", "candidate_names", "merge_status", "manual_confirmation_status"], "properties": {"project_id": {"type": "string"}, "standard_name": {"type": ["string", "null"]}, "candidate_names": {"type": "array", "items": {"type": "string"}}, "merge_status": {"type": "string"}, "manual_confirmation_status": {"type": "string"}}},
    "collaboration": {"type": "object", "additionalProperties": false, "required": ["task_id", "person_id", "role", "relation_type", "evidence_id", "parent_task_id", "related_task_id"], "properties": {"task_id": {"type": "string"}, "person_id": {"type": "string"}, "role": {"enum": ["lead", "collaborator"]}, "relation_type": {"enum": ["parent_child", "continuation", "lead", "collaborate"]}, "evidence_id": {"type": "string"}, "parent_task_id": {"type": ["string", "null"]}, "related_task_id": {"type": ["string", "null"]}}},
    "risk_candidate": {"type": "object", "additionalProperties": false, "required": ["task_id", "person_id", "status", "risk", "blocker"], "properties": {"task_id": {"type": "string"}, "person_id": {"type": "string"}, "status": {"enum": ["planned", "in_progress", "blocked", "completed"]}, "risk": {"type": ["string", "null"]}, "blocker": {"type": ["string", "null"]}}},
    "attendance_summary": {"type": "object", "additionalProperties": false, "required": ["expected_people", "submitted_by_1730_people", "submitted_by_1730_rate", "submitted_by_2200_people", "submitted_by_2200_rate", "calculation_source", "leave_people", "missing_people_count", "missing_people", "full_day_leave_people", "half_day_leave_people", "review_required_people"], "properties": {"expected_people": {"type": ["integer", "null"]}, "submitted_by_1730_people": {"type": "integer"}, "submitted_by_1730_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1}, "submitted_by_2200_people": {"type": "integer"}, "submitted_by_2200_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1}, "calculation_source": {"enum": ["stored_statistics", "recalculated", "recalculated_inconsistent_snapshot"]}, "leave_people": {"type": "integer"}, "missing_people_count": {"type": "integer"}, "missing_people": {"$ref": "#/$defs/people"}, "full_day_leave_people": {"$ref": "#/$defs/people"}, "half_day_leave_people": {"$ref": "#/$defs/people"}, "review_required_people": {"$ref": "#/$defs/people"}}},
    "efficiency_item": {"type": "object", "additionalProperties": false, "required": ["person_id", "name", "task_count", "completed_task_count", "in_progress_task_count", "blocked_task_count", "project_count", "lead_task_count", "collaboration_task_count", "evidence_ids"], "properties": {"person_id": {"type": "string"}, "name": {"type": "string"}, "task_count": {"type": "integer"}, "completed_task_count": {"type": "integer"}, "in_progress_task_count": {"type": "integer"}, "blocked_task_count": {"type": "integer"}, "project_count": {"type": "integer"}, "lead_task_count": {"type": "integer"}, "collaboration_task_count": {"type": "integer"}, "evidence_ids": {"type": "array", "items": {"type": "string"}}}},
    "project_dynamic": {"type": "object", "additionalProperties": false, "required": ["project_id", "project_name", "state", "current_stage", "owner_name", "lead_people", "collaborator_people", "task_count", "completed_task_count", "blocked_task_count", "outputs", "blockers", "evidence_ids", "snapshot_origin", "snapshot_captured_at"], "properties": {"project_id": {"type": "string"}, "project_name": {"type": "string"}, "state": {"type": ["string", "null"]}, "current_stage": {"type": ["string", "null"]}, "owner_name": {"type": ["string", "null"]}, "lead_people": {"type": "array", "items": {"type": "string"}}, "collaborator_people": {"type": "array", "items": {"type": "string"}}, "task_count": {"type": "integer"}, "completed_task_count": {"type": "integer"}, "blocked_task_count": {"type": "integer"}, "outputs": {"type": "array", "items": {"type": "string"}}, "blockers": {"type": "array", "items": {"type": "string"}}, "evidence_ids": {"type": "array", "items": {"type": "string"}}, "snapshot_origin": {"type": ["string", "null"]}, "snapshot_captured_at": {"type": ["string", "null"], "format": "date-time"}}},
    "stale_project_alert": {"type": "object", "additionalProperties": false, "required": ["project_id", "project_name", "owner_name", "state", "current_stage", "latest_report_date", "inactive_workdays", "threshold_workdays", "blocked_task_count", "snapshot_origin", "snapshot_captured_at"], "properties": {"project_id": {"type": "string"}, "project_name": {"type": "string"}, "owner_name": {"type": ["string", "null"]}, "state": {"type": ["string", "null"]}, "current_stage": {"type": ["string", "null"]}, "latest_report_date": {"type": "string", "format": "date"}, "inactive_workdays": {"type": "integer"}, "threshold_workdays": {"type": "integer", "minimum": 1}, "blocked_task_count": {"type": "integer"}, "snapshot_origin": {"enum": ["captured", "reconstructed"]}, "snapshot_captured_at": {"type": ["string", "null"], "format": "date-time"}}},
    "project_continuity": {"type": "object", "additionalProperties": false, "required": ["project_id", "project_name", "active_dates", "first_active_date", "last_active_date", "person_ids", "people", "actions", "outputs", "status_evidence", "classification", "limitation_note", "evidence_ids"], "properties": {"project_id": {"type": "string", "minLength": 1}, "project_name": {"type": "string", "minLength": 1}, "active_dates": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "format": "date"}}, "first_active_date": {"type": "string", "format": "date"}, "last_active_date": {"type": "string", "format": "date"}, "person_ids": {"$ref": "#/$defs/non_empty_unique_strings"}, "people": {"$ref": "#/$defs/non_empty_unique_strings"}, "actions": {"$ref": "#/$defs/non_empty_unique_strings"}, "outputs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "status_evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["planned", "in_progress", "blocked", "completed"]}}, "classification": {"enum": ["new", "continuing", "interrupted", "last_activity_completed"]}, "limitation_note": {"type": ["string", "null"]}, "evidence_ids": {"$ref": "#/$defs/non_empty_unique_strings"}}},
    "project_association": {"type": "object", "additionalProperties": false, "required": ["association_id", "association_type", "project_ids", "person_ids", "people", "description", "evidence_ids"], "properties": {"association_id": {"type": "string", "minLength": 1}, "association_type": {"enum": ["same_project_multi_person", "one_person_multi_project", "cross_group_collaboration"]}, "project_ids": {"$ref": "#/$defs/non_empty_unique_strings"}, "person_ids": {"$ref": "#/$defs/non_empty_unique_strings"}, "people": {"$ref": "#/$defs/non_empty_unique_strings"}, "description": {"type": "string", "minLength": 1}, "evidence_ids": {"$ref": "#/$defs/non_empty_unique_strings"}}},
    "risk_assessment": {"type": "object", "additionalProperties": false, "required": ["risk_id", "risk_type", "level", "project_id", "person_ids", "summary", "evidence_ids", "limitation_note"], "properties": {"risk_id": {"type": "string", "minLength": 1}, "risk_type": {"enum": ["deadline_concentration", "project_progress", "staffing_concentration", "information_discontinuity", "stale_project"]}, "level": {"enum": ["high", "medium", "low"]}, "project_id": {"type": ["string", "null"]}, "person_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "summary": {"type": "string", "minLength": 1}, "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "limitation_note": {"type": ["string", "null"]}}},
    "non_empty_unique_strings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "data_quality": {"type": "object", "additionalProperties": false, "required": ["project_status_coverage", "reconstructed_project_count", "limitations"], "properties": {"project_status_coverage": {"enum": ["available", "unavailable"]}, "reconstructed_project_count": {"type": "integer"}, "limitations": {"type": "array", "items": {"type": "string"}}}},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["evidence_id", "raw_text"], "properties": {"evidence_id": {"type": "string"}, "raw_text": {"type": "string"}}}
  }
}
