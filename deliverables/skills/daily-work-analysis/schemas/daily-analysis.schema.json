{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daily-work-analysis.local/schemas/daily-analysis.schema.json",
  "oneOf": [
    {"$ref": "#/$defs/analysis_v10"},
    {"$ref": "#/$defs/analysis_v11"},
    {"$ref": "#/$defs/analysis_v12"}
  ],
  "$defs": {
    "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "person_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "project_id": {"type": "string", "minLength": 1},
    "semantic_item": {
      "type": "object", "additionalProperties": false,
      "required": ["summary", "person_ids", "project_id", "evidence_ids", "limitation_note"],
      "properties": {
        "summary": {"type": "string", "minLength": 1},
        "person_ids": {"$ref": "#/$defs/person_ids"},
        "project_id": {"type": ["string", "null"], "minLength": 1},
        "evidence_ids": {"$ref": "#/$defs/evidence_ids"},
        "limitation_note": {"type": ["string", "null"]}
      }
    },
    "analysis_v11": {
      "type": "object", "additionalProperties": false,
      "required": ["data_contract_version", "overall_judgment", "efficiency_insights", "project_highlights", "risk_items", "next_day_actions"],
      "properties": {
        "data_contract_version": {"const": "1.1.0"},
        "overall_judgment": {"$ref": "#/$defs/semantic_item"},
        "efficiency_insights": {"type": "array", "items": {"$ref": "#/$defs/semantic_item"}},
        "project_highlights": {"type": "array", "items": {"$ref": "#/$defs/semantic_item"}},
        "risk_items": {"type": "array", "items": {"$ref": "#/$defs/semantic_item"}},
        "next_day_actions": {"type": "array", "items": {"$ref": "#/$defs/semantic_item"}}
      }
    },
    "analysis_v12": {
      "type": "object", "additionalProperties": false,
      "required": ["data_contract_version", "overall_judgment", "efficiency_insights", "continuity_analysis", "association_analysis", "risk_items", "next_day_actions"],
      "properties": {
        "data_contract_version": {"const": "1.2.0"},
        "overall_judgment": {"$ref": "#/$defs/semantic_item"},
        "efficiency_insights": {"type": "array", "items": {"$ref": "#/$defs/semantic_item"}},
        "continuity_analysis": {"type": "array", "items": {"$ref": "#/$defs/semantic_item"}},
        "association_analysis": {"type": "array", "items": {"$ref": "#/$defs/semantic_item"}},
        "risk_items": {"type": "array", "items": {"$ref": "#/$defs/semantic_item"}},
        "next_day_actions": {"type": "array", "items": {"$ref": "#/$defs/semantic_item"}}
      }
    },
    "work_summary": {"type": "object", "additionalProperties": false, "required": ["summary", "evidence_ids"], "properties": {"summary": {"type": "string", "minLength": 1}, "evidence_ids": {"$ref": "#/$defs/evidence_ids"}}},
    "project_highlight_v10": {"type": "object", "additionalProperties": false, "required": ["project_id", "summary", "person_ids", "evidence_ids"], "properties": {"project_id": {"$ref": "#/$defs/project_id"}, "summary": {"type": "string", "minLength": 1}, "person_ids": {"$ref": "#/$defs/person_ids"}, "evidence_ids": {"$ref": "#/$defs/evidence_ids"}}},
    "risk_item_v10": {"type": "object", "additionalProperties": false, "required": ["description", "evidence_ids"], "properties": {"description": {"type": "string", "minLength": 1}, "person_ids": {"$ref": "#/$defs/person_ids"}, "project_id": {"$ref": "#/$defs/project_id"}, "evidence_ids": {"$ref": "#/$defs/evidence_ids"}}},
    "next_day_action_v10": {"type": "object", "additionalProperties": false, "required": ["action", "evidence_ids"], "properties": {"action": {"type": "string", "minLength": 1}, "person_ids": {"$ref": "#/$defs/person_ids"}, "project_id": {"$ref": "#/$defs/project_id"}, "evidence_ids": {"$ref": "#/$defs/evidence_ids"}}},
    "analysis_v10": {
      "type": "object", "additionalProperties": false,
      "required": ["data_contract_version", "work_summary", "project_highlights", "risk_items", "next_day_actions"],
      "properties": {
        "data_contract_version": {"const": "1.0.0"},
        "work_summary": {"$ref": "#/$defs/work_summary"},
        "project_highlights": {"type": "array", "items": {"$ref": "#/$defs/project_highlight_v10"}},
        "risk_items": {"type": "array", "items": {"$ref": "#/$defs/risk_item_v10"}},
        "next_day_actions": {"type": "array", "items": {"$ref": "#/$defs/next_day_action_v10"}}
      }
    }
  }
}
